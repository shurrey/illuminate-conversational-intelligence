# Illuminate Conversational Intelligence - Environment Configuration
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# Application
PORT=8000
LOG_LEVEL=INFO
ILLUMINATE_MOCK_MODE=true  # Set to false when you have real Snowflake credentials

# LLM Configuration
# For local development with Anthropic API
ANTHROPIC_API_KEY=  # Get from https://console.anthropic.com/
USE_BEDROCK=false

# Model IDs for Anthropic API (local development)
MODEL_ORCHESTRATOR=claude-sonnet-4-20250514
MODEL_VALIDATOR=claude-sonnet-4-20250514
MODEL_WORKER=claude-opus-4-20250514

# Model IDs for AWS Bedrock (production)
BEDROCK_MODEL_ORCHESTRATOR=anthropic.claude-sonnet-4-20250514-v1:0
BEDROCK_MODEL_VALIDATOR=anthropic.claude-sonnet-4-20250514-v1:0
BEDROCK_MODEL_WORKER=anthropic.claude-opus-4-20250514-v1:0

# Snowflake Connection (Anthology Illuminate)
# Account: Find at Developer > Launch Snowflake (e.g., oha52661)
# Database: Find in Snowflake left panel (e.g., BLACKBOARD_DATA_xxx)
# Service account: Manage at Developer > Settings
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_WAREHOUSE=
SNOWFLAKE_DATABASE=
SNOWFLAKE_ROLE=

# Available CDM schemas:
#   CDM_LMS  - Blackboard Learn (courses, grades, enrollments) - overnight refresh
#   CDM_SIS  - Anthology Student (demographics, programs) - daily 8:00 UTC
#   CDM_CLB  - Collaborate (sessions, attendance) - every 2 hours
#   CDM_TLM  - Telemetry (activity, engagement) - every 30 minutes
#   CDM_MEDIA - Video Studio - near real-time
#   CDM_ALY  - Ally (accessibility scores)
#   LEARN    - Blackboard ODS (191 source tables)

# AWS (for AgentCore deployment)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# A2A Protocol
A2A_BASE_URL=http://localhost:9000
A2A_TIMEOUT=30.0
A2A_ENABLE_STREAMING=true

# Authentication (stub mode)
VALID_API_KEYS=dev-key-123,test-key-456

# Frontend
VITE_API_URL=http://localhost:8000
VITE_MOCK_MODE=true
